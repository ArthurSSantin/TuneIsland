<Window x:Class="TuneIsland.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TuneIsland"
        Width="560" Height="105"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Foreground="White">

    <Window.Resources>
        <Style x:Key="ControlButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Island"
            Width="105" Height="21"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            Background="Black"
            ClipToBounds="True"
            CornerRadius="10"
            MouseEnter="Island_MouseEnter"
            MouseLeave="Island_MouseLeave"
            MouseWheel="Island_MouseWheel">
        <Grid>

            <!-- Estado compacto: mini capa + equalizador -->
            <Grid x:Name="CompactPanel" Margin="4,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="CompactArtFrame" Width="14" Height="14" CornerRadius="4" VerticalAlignment="Center"
                        ClipToBounds="True" Background="#1F1F1F">
                    <Image x:Name="CompactArt" Stretch="UniformToFill"/>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="8" Margin="0,0,4,0">
                    <Border x:Name="Bar1" Width="2" Height="8" Margin="1,0" CornerRadius="1"
                            Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,1">
                        <Border.RenderTransform><ScaleTransform ScaleY="0.3"/></Border.RenderTransform>
                    </Border>
                    <Border x:Name="Bar2" Width="2" Height="8" Margin="1,0" CornerRadius="1"
                            Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,1">
                        <Border.RenderTransform><ScaleTransform ScaleY="0.3"/></Border.RenderTransform>
                    </Border>
                    <Border x:Name="Bar3" Width="2" Height="8" Margin="1,0" CornerRadius="1"
                            Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,1">
                        <Border.RenderTransform><ScaleTransform ScaleY="0.3"/></Border.RenderTransform>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Estado expandido: capa grande, texto, progresso e controles -->
            <Grid x:Name="ExpandedPanel" Margin="10,8,10,6" Opacity="0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="64" Height="64" VerticalAlignment="Top" CornerRadius="10"
                        ClipToBounds="True" Background="#1F1F1F">
                    <Image x:Name="LargeArt" Stretch="UniformToFill"/>
                </Border>

                <Grid Grid.Column="1" Margin="10,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="TitleClip" Grid.Row="0" ClipToBounds="True" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Left" TextWrapping="NoWrap">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="TitleShift"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Border>

                    <TextBlock x:Name="ArtistText" Grid.Row="1" FontSize="11" Foreground="#B3FFFFFF"
                               TextTrimming="CharacterEllipsis"/>

                    <Grid x:Name="ProgressHit" Grid.Row="3" Background="Transparent" Cursor="Hand"
                          MouseLeftButtonDown="Progress_MouseLeftButtonDown"
                          VerticalAlignment="Center">
                        <Border Height="3" CornerRadius="1.5" Background="#33FFFFFF" VerticalAlignment="Center"/>
                        <Border x:Name="ProgressFill" Height="3" CornerRadius="1.5"
                                Width="{Binding ActualWidth, ElementName=ProgressHit}"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                RenderTransformOrigin="0,0.5"
                                Background="{DynamicResource AccentBrush}">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ProgressFillScale" ScaleX="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="4">
                        <TextBlock x:Name="TimeCurrent" FontSize="9" Foreground="#99FFFFFF" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TimeTotal" FontSize="9" Foreground="#99FFFFFF" HorizontalAlignment="Right"/>
                    </Grid>

                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="PrevButton" Content="&#xE892;" Style="{StaticResource ControlButton}" Click="Prev_Click"/>
                        <Button x:Name="PlayPauseButton" Content="&#xE769;" Style="{StaticResource ControlButton}" Click="PlayPause_Click"/>
                        <Button x:Name="NextButton" Content="&#xE893;" Style="{StaticResource ControlButton}" Click="Next_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
