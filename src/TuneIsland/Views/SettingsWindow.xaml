<Window x:Class="TuneIsland.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações do TuneIsland"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">

    <StackPanel Margin="20">

        <TextBlock Text="Estilo" Margin="0,0,0,4"/>
        <ComboBox x:Name="StyleBox" Margin="0,0,0,12">
            <ComboBoxItem Content="Attached (colada no topo)"/>
            <ComboBoxItem Content="Floating (flutuante)"/>
        </ComboBox>

        <TextBlock Text="Monitor" Margin="0,0,0,4"/>
        <ComboBox x:Name="MonitorBox" Margin="0,0,0,12"/>

        <TextBlock x:Name="WidthLabel" Margin="0,0,0,4"/>
        <Slider x:Name="WidthSlider" Minimum="180" Maximum="560" TickFrequency="10"
                IsSnapToTickEnabled="True" ValueChanged="WidthSlider_ValueChanged" Margin="0,0,0,12"/>

        <TextBlock x:Name="ExpandLabel" Margin="0,0,0,4"/>
        <Slider x:Name="ExpandSlider" Minimum="1" Maximum="10" TickFrequency="1"
                IsSnapToTickEnabled="True" ValueChanged="ExpandSlider_ValueChanged" Margin="0,0,0,14"/>

        <CheckBox x:Name="StartupCheck" Content="Iniciar com o Windows" Margin="0,0,0,8"/>
        <CheckBox x:Name="HideIdleCheck" Content="Esconder quando nada estiver tocando" Margin="0,0,0,8"/>
        <CheckBox x:Name="HideFullscreenCheck" Content="Esconder em apps em tela cheia"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" Padding="14,6" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Salvar" Padding="14,6" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
